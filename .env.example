VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only used by `npm run db:upgrade` (never prefix with VITE_ — that would expose it in the browser).
# Supabase → Connect → Connection string → Session pooler. Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
